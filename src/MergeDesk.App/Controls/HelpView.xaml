<UserControl x:Class="MergeDesk.App.Controls.HelpView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="A little help at every step" Style="{StaticResource Heading}"/><TextBlock Text="Search the guide, choose a topic or watch the captioned walkthrough. Hover over any option for a quick explanation." Style="{StaticResource MutedText}"/></StackPanel>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Search help" FontWeight="SemiBold"/><TextBox x:Name="Search" TextChanged="SearchChanged" ToolTip="Filter topics by a word or phrase; clear the box to show all topics." AutomationProperties.Name="Search help" ToolTipService.ShowOnDisabled="True"/></StackPanel><Button Grid.Column="1" Content="Watch walkthrough video" Click="WatchVideo" Margin="16,0,0,12" ToolTip="Open the bundled captioned MP4 in your default video player. You can pause and replay it." ToolTipService.ShowOnDisabled="True"/></Grid>
  <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions><ListBox x:Name="Topics" DisplayMemberPath="Title" Padding="6" SelectionChanged="TopicChanged" ToolTip="Choose a help topic." ToolTipService.ShowOnDisabled="True"/><ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock x:Name="TopicTitle" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,18"/><TextBlock x:Name="TopicBody" FontSize="16" LineHeight="27" TextWrapping="Wrap"/></StackPanel></ScrollViewer></Grid>
 </Grid>
</UserControl>
