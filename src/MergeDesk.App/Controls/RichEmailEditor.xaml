<UserControl x:Class="MergeDesk.App.Controls.RichEmailEditor" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:MergeDesk.App.Controls">
 <UserControl.Resources>
  <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Padding" Value="10,6"/><Setter Property="Margin" Value="0,0,4,4"/><Setter Property="Focusable" Value="False"/><Setter Property="MinHeight" Value="32"/></Style>
  <Style x:Key="FormatToggle" TargetType="ToggleButton">
   <Setter Property="Width" Value="34"/><Setter Property="Height" Value="32"/><Setter Property="Margin" Value="0,0,4,4"/><Setter Property="Focusable" Value="False"/><Setter Property="Foreground" Value="#1E293B"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#CFD8DF"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton"><Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Surface" Property="Background" Value="#DDECE5"/><Setter TargetName="Surface" Property="BorderBrush" Value="#146C60"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#146C60"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
 </UserControl.Resources>
 <StackPanel>
  <Border BorderBrush="#CFD8DF" BorderThickness="1" CornerRadius="5" Margin="0,6,0,10">
   <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Background="#EAF0F3" Padding="8,8,8,4" CornerRadius="4,4,0,0"><WrapPanel>
     <ComboBox x:Name="FontPicker" ItemsSource="{x:Static local:RichEmailEditor.FontNames}" SelectionChanged="FontChanged" Width="135" Margin="0,0,6,4" Padding="5" MinHeight="32" ToolTip="Font" AutomationProperties.Name="Email font" ToolTipService.ShowOnDisabled="True"/>
     <ComboBox x:Name="SizePicker" ItemsSource="{x:Static local:RichEmailEditor.FontSizes}" SelectionChanged="FontSizeChanged" Width="60" Margin="0,0,8,4" Padding="5" MinHeight="32" ToolTip="Font size in points" AutomationProperties.Name="Email font size" ToolTipService.ShowOnDisabled="True"/>
     <ToggleButton x:Name="BoldToggle" Content="B" FontWeight="Bold" Style="{StaticResource FormatToggle}" Command="EditingCommands.ToggleBold" CommandTarget="{Binding ElementName=Editor}" ToolTip="Bold (Ctrl+B)" AutomationProperties.Name="Bold" ToolTipService.ShowOnDisabled="True"/>
     <ToggleButton x:Name="ItalicToggle" Content="I" FontStyle="Italic" Style="{StaticResource FormatToggle}" Command="EditingCommands.ToggleItalic" CommandTarget="{Binding ElementName=Editor}" ToolTip="Italic (Ctrl+I)" AutomationProperties.Name="Italic" ToolTipService.ShowOnDisabled="True"/>
     <ToggleButton x:Name="UnderlineToggle" Style="{StaticResource FormatToggle}" Command="EditingCommands.ToggleUnderline" CommandTarget="{Binding ElementName=Editor}" ToolTip="Underline (Ctrl+U)" AutomationProperties.Name="Underline" ToolTipService.ShowOnDisabled="True"><TextBlock Text="U" TextDecorations="Underline"/></ToggleButton>
     <ComboBox x:Name="ColorPicker" ItemsSource="{x:Static local:RichEmailEditor.TextColors}" DisplayMemberPath="Name" SelectionChanged="ColorChanged" Width="95" Margin="4,0,6,4" Padding="5" MinHeight="32" ToolTip="Text colour" AutomationProperties.Name="Text colour" ToolTipService.ShowOnDisabled="True"/>
    </WrapPanel></Border>
    <Border Grid.Row="1" Background="#EAF0F3" Padding="8,0,8,4"><WrapPanel>
     <Button Content="Left" Style="{StaticResource ToolButton}" Command="EditingCommands.AlignLeft" CommandTarget="{Binding ElementName=Editor}" ToolTip="Align paragraph left" ToolTipService.ShowOnDisabled="True"/>
     <Button Content="Centre" Style="{StaticResource ToolButton}" Command="EditingCommands.AlignCenter" CommandTarget="{Binding ElementName=Editor}" ToolTip="Centre paragraph" ToolTipService.ShowOnDisabled="True"/>
     <Button Content="Right" Style="{StaticResource ToolButton}" Command="EditingCommands.AlignRight" CommandTarget="{Binding ElementName=Editor}" ToolTip="Align paragraph right" ToolTipService.ShowOnDisabled="True"/>
     <Button Content="Bullets" Style="{StaticResource ToolButton}" Command="EditingCommands.ToggleBullets" CommandTarget="{Binding ElementName=Editor}" ToolTip="Turn the current paragraph into a bulleted list." ToolTipService.ShowOnDisabled="True"/>
     <Button Content="Numbering" Style="{StaticResource ToolButton}" Command="EditingCommands.ToggleNumbering" CommandTarget="{Binding ElementName=Editor}" ToolTip="Turn the current paragraph into a numbered list." ToolTipService.ShowOnDisabled="True"/>
     <Button Content="Undo" Style="{StaticResource ToolButton}" Command="ApplicationCommands.Undo" CommandTarget="{Binding ElementName=Editor}" ToolTip="Undo the previous body edit (Ctrl+Z)." ToolTipService.ShowOnDisabled="True"/>
     <Button Content="Redo" Style="{StaticResource ToolButton}" Command="ApplicationCommands.Redo" CommandTarget="{Binding ElementName=Editor}" ToolTip="Restore an undone body edit (Ctrl+Y)." ToolTipService.ShowOnDisabled="True"/>
    </WrapPanel></Border>
    <RichTextBox x:Name="Editor" Grid.Row="2" Height="260" Padding="14" BorderThickness="0" VerticalScrollBarVisibility="Auto" AcceptsTab="False" IsDocumentEnabled="False" IsInactiveSelectionHighlightEnabled="True" TextChanged="EditorChanged" SelectionChanged="EditorSelectionChanged" AutomationProperties.Name="Visual email body" ToolTip="Write formatted text here. Select text to format it; HTML is generated automatically." ToolTipService.ShowOnDisabled="True"/>
    <Border Grid.Row="3" Padding="8" BorderBrush="#CFD8DF" BorderThickness="0,1,0,0"><WrapPanel>
     <ComboBox x:Name="FieldPicker" ItemsSource="{Binding Fields, RelativeSource={RelativeSource AncestorType=local:RichEmailEditor}}" DisplayMemberPath="Field" SelectedValuePath="Field" Width="150" Margin="0,0,6,4" Padding="5" MinHeight="32" ToolTip="Choose a mapped merge field" AutomationProperties.Name="Merge field to insert" ToolTipService.ShowOnDisabled="True"/>
     <Button Content="Insert merge field" Style="{StaticResource ToolButton}" Click="InsertField" ToolTip="Insert the chosen mapped field at the body cursor." ToolTipService.ShowOnDisabled="True"/>
     <Button Content="Insert image…" Style="{StaticResource ToolButton}" Click="InsertImage" ToolTip="Embed a PNG, JPEG or GIF at the body cursor; maximum 2 MiB per image." ToolTipService.ShowOnDisabled="True"/>
     <Button Content="Use email text for plain-text version" Style="{StaticResource ToolButton}" Click="CopyPlainText" ToolTip="Copy current body text to the plain-text alternative; repeat after later changes." ToolTipService.ShowOnDisabled="True"/>
    </WrapPanel></Border>
   </Grid>
  </Border>
  <Expander x:Name="PictureSettings" Header="Picture settings" Margin="0,0,0,12" ToolTip="Choose an embedded picture to resize or align its paragraph." ToolTipService.ShowOnDisabled="True">
   <StackPanel Margin="0,8,0,0">
    <ComboBox x:Name="PicturePicker" DisplayMemberPath="Label" SelectionChanged="PictureSelected" ToolTip="Choose the picture to edit. All embedded pictures in the body appear here." ToolTipService.ShowOnDisabled="True"/>
    <WrapPanel Margin="0,6,0,0"><TextBlock Text="Width (pixels)" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBox x:Name="PictureWidth" Width="75" ToolTip="Enter 1–1200 pixels. Height changes automatically to preserve proportions." ToolTipService.ShowOnDisabled="True"/><Button Content="Apply size and description" Click="ApplyPicture" ToolTip="Apply the width and alternative text to the chosen picture." ToolTipService.ShowOnDisabled="True"/><Button Content="Original size" Click="OriginalPicture" ToolTip="Restore the picture's original width, limited to 1200 pixels." ToolTipService.ShowOnDisabled="True"/></WrapPanel>
    <TextBlock Text="Alternative text"/><TextBox x:Name="PictureDescription" ToolTip="Describe the picture for readers who cannot see it." ToolTipService.ShowOnDisabled="True"/>
    <WrapPanel><Button Content="Picture left" Click="AlignPicture" Tag="Left" ToolTip="Align the picture's entire paragraph left. Text on that line moves too." ToolTipService.ShowOnDisabled="True"/><Button Content="Picture centre" Click="AlignPicture" Tag="Center" ToolTip="Centre the picture's entire paragraph. Text on that line moves too." ToolTipService.ShowOnDisabled="True"/><Button Content="Picture right" Click="AlignPicture" Tag="Right" ToolTip="Align the picture's entire paragraph right. Text on that line moves too." ToolTipService.ShowOnDisabled="True"/></WrapPanel>
    <TextBlock Text="Height follows width automatically. Alignment affects the whole paragraph; place a picture on its own line for independent alignment." Foreground="#536277" TextWrapping="Wrap"/>
   </StackPanel>
  </Expander>
  <TextBlock x:Name="ImportNotice" Foreground="#775015" TextWrapping="Wrap" Margin="0,0,0,10" Visibility="Collapsed" Text="This template includes layout the visual editor cannot reproduce. Editing here will simplify it. Use Advanced HTML source to preserve its original layout."/>
  <TextBlock x:Name="EditorHint" Foreground="#536277" TextWrapping="Wrap" Margin="0,0,0,10" Text="Select text to format it, or choose formatting before typing. Ctrl+B / Ctrl+I / Ctrl+U work here too."/>
  <Expander Header="Advanced HTML source" Margin="0,0,0,12" ToolTip="Show generated HTML. Editing custom source may not be preserved by visual editing." ToolTipService.ShowOnDisabled="True">
   <StackPanel><TextBlock Text="HTML is generated automatically. Advanced users can edit the source; visual editing supports text formatting and lists, and may simplify custom layouts." Foreground="#536277" TextWrapping="Wrap" Margin="0,8,0,4"/>
    <TextBox Text="{Binding Html, RelativeSource={RelativeSource AncestorType=local:RichEmailEditor}, UpdateSourceTrigger=LostFocus}" AcceptsReturn="True" VerticalContentAlignment="Top" Height="180" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" TextWrapping="Wrap" AutomationProperties.Name="Advanced HTML source" ToolTip="Optional HTML source for experienced users; changes apply when focus leaves this box." ToolTipService.ShowOnDisabled="True"/>
   </StackPanel>
  </Expander>
 </StackPanel>
</UserControl>
