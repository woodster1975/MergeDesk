<Window x:Class="MergeDesk.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:MergeDesk.App.Controls" Icon="Assets/MergeDesk.ico" Title="MergeDesk — Mail merge workspace" Width="1200" Height="820" MinWidth="920" MinHeight="650" WindowStartupLocation="CenterScreen">
 <Grid ToolTipService.ShowOnDisabled="True" ToolTipService.InitialShowDelay="450" ToolTipService.ShowDuration="20000">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Background="#183B3B" Padding="28,20"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel><StackPanel Orientation="Horizontal"><Image x:Name="BrandMark" Source="Assets/MergeDesk-logo-v2.png" Width="40" Height="40" Margin="0,0,10,0" Stretch="Uniform" AutomationProperties.Name="MergeDesk logo"/><TextBlock Text="MergeDesk" FontSize="27" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/></StackPanel><TextBlock Text="Personal messages. One thoughtful workflow." Foreground="#CCE1DC" Margin="0,4,0,0"/></StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="Help (F1)" Click="ShowHelp" ToolTip="Open searchable instructions and the captioned video." ToolTipService.ShowOnDisabled="True"/><Button Content="Open project" Command="{Binding OpenProjectCommand}" ToolTip="Restore a saved template, mappings and source file paths." ToolTipService.ShowOnDisabled="True"/><Button Content="Save project" Command="{Binding SaveProjectCommand}" ToolTip="Save templates, mappings, file paths and embedded images as a project." ToolTipService.ShowOnDisabled="True"/><Border Background="#DDECE5" CornerRadius="4" Padding="12,8" Margin="12,0,0,8"><TextBlock Text="PREVIEW • DRAFT • SEND" Foreground="#184E41" FontWeight="SemiBold"/></Border></StackPanel>
  </Grid></Border>
  <Border Grid.Row="1" Background="#DDECE5" Padding="24,12" Visibility="{Binding HasPendingRecovery, Converter={StaticResource BoolVisibility}}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding RecoveryDescription}" VerticalAlignment="Center" Margin="0,0,16,0"/><WrapPanel Grid.Column="1"><Button Content="Restore autosave" Command="{Binding RestoreRecoveryCommand}" Style="{StaticResource Primary}" Margin="0,0,8,0" ToolTip="Restore your template, mappings and recipient ticks. Outlook will remain disconnected." ToolTipService.ShowOnDisabled="True"/><Button Content="Start fresh" Command="{Binding DismissRecoveryCommand}" Margin="0" ToolTip="Dismiss this recovery snapshot and start with a new workspace." ToolTipService.ShowOnDisabled="True"/></WrapPanel></Grid></Border>
  <TabControl Grid.Row="2" Margin="24,20,24,16" SelectedIndex="{Binding SelectedTab}" Background="White" BorderBrush="{StaticResource Line}">
   <TabItem Header="1  Recipients" ToolTip="Open 1  Recipients." ToolTipService.ShowOnDisabled="True">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24"><Grid MinHeight="560" Height="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" IsEnabled="{Binding IsEditable}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <StackPanel><TextBlock Text="Start with your recipient data" Style="{StaticResource Heading}"/><TextBlock Text="Load a CSV or Excel workbook. Give each source column a merge field name, then use that name in your message." Style="{StaticResource MutedText}"/></StackPanel>
     <Grid Grid.Row="1" Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Button Content="Load CSV / Excel" Command="{Binding ImportCommand}" Style="{StaticResource Primary}" ToolTip="Choose a CSV or .xlsx file containing one recipient per row." ToolTipService.ShowOnDisabled="True"/>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0"><TextBlock Text="Worksheet" VerticalAlignment="Center" Margin="0,0,8,8"/><TextBox Text="{Binding Worksheet}" Width="55" ToolTip="Excel worksheet number, starting at 1. Reload to apply." ToolTipService.ShowOnDisabled="True"/></StackPanel>
      <Button Grid.Column="2" Content="Reload" Command="{Binding ReloadCommand}" Margin="10,0,8,8" ToolTip="Read the source file again using the selected worksheet." ToolTipService.ShowOnDisabled="True"/>
      <StackPanel Grid.Column="3" Margin="16,0,0,0"><TextBlock Text="{Binding RecipientSummary}" FontWeight="SemiBold"/><TextBlock Text="{Binding SourcePath}" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding SourcePath}"/></StackPanel>
     </Grid>
     <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="330"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <TextBlock Text="Field mapping" FontSize="18" FontWeight="SemiBold"/>
       <TextBlock Grid.Row="1" Text="Edit a field name to match your template. Select a source column for each field. Select a row and press Delete to remove it." Style="{StaticResource MutedText}"/>
       <DataGrid Grid.Row="2" ItemsSource="{Binding Mappings}" RowHeight="44" CanUserDeleteRows="True" SelectionMode="Single" ToolTip="Edit field names and source columns. Select a row and press Delete to remove it." ToolTipService.ShowOnDisabled="True">
        <DataGrid.Columns><DataGridTextColumn Header="Merge field" Width="*" Binding="{Binding Field, UpdateSourceTrigger=PropertyChanged}"/>
         <DataGridTemplateColumn Header="Source column" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding DataContext.Columns, RelativeSource={RelativeSource AncestorType=DataGrid}}" SelectedItem="{Binding Column, UpdateSourceTrigger=PropertyChanged}" Margin="3" ToolTip="Choose the data column supplying this merge field." ToolTipService.ShowOnDisabled="True"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
        </DataGrid.Columns>
       </DataGrid>
       <Button Grid.Row="3" Content="Add merge field" Command="{Binding AddMappingCommand}" HorizontalAlignment="Left" Margin="0,12,0,0" ToolTip="Add a merge field and choose its source column." ToolTipService.ShowOnDisabled="True"/>
      </Grid>
      <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
       <StackPanel><TextBlock Text="Choose recipients" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding InclusionSummary}" FontWeight="SemiBold" Foreground="{StaticResource Accent}" Margin="0,6,0,12"/></StackPanel>
       <WrapPanel Grid.Row="1" VerticalAlignment="Center"><StackPanel Margin="0,0,12,0"><TextBlock Text="Search recipients"/><TextBox Text="{Binding RecipientSearch, UpdateSourceTrigger=PropertyChanged}" Width="220" AutomationProperties.Name="Search recipients" ToolTip="Search values in any source column. Search only hides rows; ticks control who is included." ToolTipService.ShowOnDisabled="True"/></StackPanel><Button Content="Include shown" Command="{Binding IncludeShownCommand}" VerticalAlignment="Bottom" Margin="0,0,8,12" ToolTip="Tick all rows currently shown by the search." ToolTipService.ShowOnDisabled="True"/><Button Content="Exclude shown" Command="{Binding ExcludeShownCommand}" VerticalAlignment="Bottom" Margin="0,0,8,12" ToolTip="Untick all rows currently shown by the search." ToolTipService.ShowOnDisabled="True"/><Button Content="Exclude all" Command="{Binding ExcludeAllCommand}" VerticalAlignment="Bottom" Margin="0,0,0,12" ToolTip="Untick every recipient, including rows hidden by search." ToolTipService.ShowOnDisabled="True"/></WrapPanel>
       <TextBlock Grid.Row="2" Text="Ticks control drafts, exports and batch sending. Ticked rows hidden by search are still included." Style="{StaticResource MutedText}"/>
       <DataGrid x:Name="RecipientGrid" Grid.Row="3" ItemsSource="{Binding RecipientView}" AutoGenerateColumns="True" AutoGeneratingColumn="RecipientColumn" IsReadOnly="True" CanUserDeleteRows="False" ToolTip="Tick Include to add a row to the batch. Source row numbers stay the same when searching or sorting. Edit other values in the original file, then Reload." ToolTipService.ShowOnDisabled="True"/>
      </Grid>
     </Grid>
    </Grid></ScrollViewer>
   </TabItem>
   <TabItem Header="2  Compose" ToolTip="Open 2  Compose." ToolTipService.ShowOnDisabled="True">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><Grid Margin="24" IsEnabled="{Binding IsEditable}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="28"/><ColumnDefinition Width="350"/></Grid.ColumnDefinitions>
     <StackPanel><TextBlock Text="Write once. Make it personal." Style="{StaticResource Heading}"/><TextBlock Text="Write and format your message below. Use Insert merge field to add personal details. Separate multiple email addresses with commas or semicolons." Style="{StaticResource MutedText}"/>
      <Expander x:Name="LibraryPanel" Header="Templates &amp; signatures" Margin="0,12,0,12" ToolTip="Save and reuse messages or append a saved signature." ToolTipService.ShowOnDisabled="True"><StackPanel Margin="0,10,0,0">
       <TextBlock Text="Templates" FontWeight="SemiBold"/>
       <WrapPanel><ComboBox ItemsSource="{Binding Templates}" SelectedItem="{Binding SelectedTemplate}" DisplayMemberPath="Name" Width="200" ToolTip="Choose a saved template. Selecting it does not change your message." ToolTipService.ShowOnDisabled="True"/><Button Content="Use template" Command="{Binding UseTemplateCommand}" ToolTip="Replace message fields, mappings and attachment paths. Recipient selection and account remain unchanged." ToolTipService.ShowOnDisabled="True"/><Button Content="Remove" Command="{Binding DeleteTemplateCommand}" ToolTip="Remove the selected template after confirmation." ToolTipService.ShowOnDisabled="True"/></WrapPanel>
       <TextBlock Text="Template name"/>
       <WrapPanel><TextBox Text="{Binding TemplateName, UpdateSourceTrigger=PropertyChanged}" Width="200" MaxLength="100" ToolTip="Name for the current message template. A selected template will be updated." ToolTipService.ShowOnDisabled="True"/><Button Content="Save current message" Command="{Binding SaveTemplateCommand}" ToolTip="Save current message, mappings and attachment paths; update the selected template." ToolTipService.ShowOnDisabled="True"/><Button Content="Save as new…" Command="{Binding NewTemplateCommand}" ToolTip="Clear the template selection and name, then enter a new name and save the current message." ToolTipService.ShowOnDisabled="True"/></WrapPanel>
       <TextBlock Text="Signatures" FontWeight="SemiBold" Margin="0,10,0,0"/>
       <WrapPanel><ComboBox ItemsSource="{Binding Signatures}" SelectedItem="{Binding SelectedSignature}" DisplayMemberPath="Name" Width="200" ToolTip="Choose a saved signature." ToolTipService.ShowOnDisabled="True"/><Button Content="Append signature" Command="{Binding AppendSignatureCommand}" ToolTip="Add the selected signature to the end of both message bodies." ToolTipService.ShowOnDisabled="True"/><Button Content="New…" Command="{Binding NewSignatureCommand}" ToolTip="Create a formatted signature with optional embedded logo." ToolTipService.ShowOnDisabled="True"/><Button Content="Edit…" Command="{Binding EditSignatureCommand}" ToolTip="Edit the saved signature; previously inserted copies stay unchanged." ToolTipService.ShowOnDisabled="True"/><Button Content="Remove" Command="{Binding DeleteSignatureCommand}" ToolTip="Remove the selected signature after confirmation." ToolTipService.ShowOnDisabled="True"/><Button Content="Refresh" Command="{Binding RefreshLibraryCommand}" ToolTip="Reload saved items from this computer." ToolTipService.ShowOnDisabled="True"/></WrapPanel>
       <TextBlock Text="{Binding LibraryStatus}" Style="{StaticResource MutedText}"/>
      </StackPanel></Expander>
      <TextBlock Text="To"/><TextBox Text="{Binding To, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="To template" ToolTip="Recipient addresses or merge tokens, for example {{Email}}; separate addresses with commas or semicolons." ToolTipService.ShowOnDisabled="True"/>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="CC (optional)"/><TextBox Text="{Binding Cc, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="CC template" ToolTip="Optional visible copy recipients; accepts addresses and merge tokens." ToolTipService.ShowOnDisabled="True"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="BCC (optional)"/><TextBox Text="{Binding Bcc, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="BCC template" ToolTip="Optional hidden copy recipients; accepts addresses and merge tokens." ToolTipService.ShowOnDisabled="True"/></StackPanel></Grid>
      <TextBlock Text="Subject"/><TextBox x:Name="SubjectEditor" Text="{Binding Subject, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Subject template" ToolTip="Email subject; use the picker below to insert a field at the cursor." ToolTipService.ShowOnDisabled="True"/>
      <WrapPanel Margin="0,0,0,12"><ComboBox x:Name="SubjectFieldPicker" ItemsSource="{Binding Mappings}" DisplayMemberPath="Field" SelectedValuePath="Field" Width="180" Margin="0,0,8,8" AutomationProperties.Name="Subject merge field" ToolTip="Choose a mapped field to insert into the subject." ToolTipService.ShowOnDisabled="True"/><Button x:Name="SubjectInsertField" Content="Insert merge field in subject" Click="InsertSubjectField" ToolTip="Insert the selected field at the subject cursor, replacing any selected text." ToolTipService.ShowOnDisabled="True"/><TextBlock x:Name="SubjectFieldHint" Text="Inserts at the subject cursor or replaces selected text." VerticalAlignment="Center" Foreground="{StaticResource Muted}" Margin="4,0,0,8"/></WrapPanel>
      <TextBlock Text="Email body" FontWeight="SemiBold"/>
      <controls:RichEmailEditor x:Name="EmailEditor" Html="{Binding Html, Mode=TwoWay}" Fields="{Binding Mappings}" PlainTextRequested="UseEmailPlainText"/>
      <TextBlock Text="Plain-text body" FontWeight="SemiBold"/><TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" VerticalContentAlignment="Top" Height="160" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" AutomationProperties.Name="Plain text email body" ToolTip="Plain-text alternative; update this after changing the formatted body." ToolTipService.ShowOnDisabled="True"/>
     </StackPanel>
     <StackPanel Grid.Column="2"><TextBlock Text="Attachments" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,12"/><TextBlock Text="Global files go to every recipient. Patterns produce a separate path for each row." Style="{StaticResource MutedText}"/>
      <WrapPanel><Button Content="Add global files" Command="{Binding AddAttachmentCommand}" ToolTip="Choose files to attach to every merged email." ToolTipService.ShowOnDisabled="True"/><Button Content="Clear files" Command="{Binding ClearAttachmentsCommand}" ToolTip="Remove all global attachments from this project." ToolTipService.ShowOnDisabled="True"/></WrapPanel>
      <ListBox ItemsSource="{Binding Attachments}" Height="150" Margin="0,0,0,20" HorizontalContentAlignment="Stretch" ToolTip="Files included with every message." ToolTipService.ShowOnDisabled="True"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Padding="6"/></DataTemplate></ListBox.ItemTemplate></ListBox>
      <TextBlock Text="Per-recipient paths" FontWeight="SemiBold"/><TextBox Text="{Binding Patterns, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" VerticalContentAlignment="Top" Height="120" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Per recipient attachment patterns" ToolTip="One absolute attachment path per line; tokens are replaced for each recipient." ToolTipService.ShowOnDisabled="True"/>
      <TextBlock Text="One absolute path per line, for example:&#10;C:\Statements\{{AccountNo}}.pdf" Style="{StaticResource MutedText}"/>
      <Separator Margin="0,8,0,20"/><TextBlock Text="Before you run" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Validate the complete batch and inspect individual messages, then create Outlook drafts or export a dry run. Every validation issue must be resolved." Style="{StaticResource MutedText}"/>
      <Button Content="Validate all recipients" Command="{Binding ValidateCommand}" Style="{StaticResource Primary}" HorizontalAlignment="Left" ToolTip="Check every recipient and attachment; fix all issues before running." ToolTipService.ShowOnDisabled="True"/>
     </StackPanel>
    </Grid></ScrollViewer>
   </TabItem>
   <TabItem Header="3  Validate &amp; preview" ToolTip="Open validation and preview." ToolTipService.ShowOnDisabled="True">
    <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <StackPanel><TextBlock Text="Check the details before creating messages" Style="{StaticResource Heading}"/><TextBlock Text="Preview a source row below. Validation checks included recipients for duplicate To addresses; preview can show any source row." Style="{StaticResource MutedText}"/></StackPanel>
     <WrapPanel Grid.Row="1"><Button Content="Validate all" Command="{Binding ValidateCommand}" ToolTip="Check every recipient and attachment; fix all issues before running." ToolTipService.ShowOnDisabled="True"/><TextBlock Text="Source row" VerticalAlignment="Center" Margin="12,0,8,12"/><ComboBox ItemsSource="{Binding Recipients}" SelectedItem="{Binding SelectedRecipient}" DisplayMemberPath="Row" Width="100" IsEnabled="{Binding IsEditable}" AutomationProperties.Name="Preview recipient row" ToolTip="Choose the source row to preview." ToolTipService.ShowOnDisabled="True"/><Button Content="Refresh preview" Command="{Binding PreviewCommand}" Margin="12,0,0,12" ToolTip="Refresh the merged preview for the selected source row." ToolTipService.ShowOnDisabled="True"/></WrapPanel>
     <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="390"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Validation issues" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/><DataGrid x:Name="ValidationIssues" Grid.Row="1" ItemsSource="{Binding Issues}" IsReadOnly="True" RowHeight="NaN" MinRowHeight="36" ToolTip="All issues must be resolved. Row 0 identifies a template or batch issue." ToolTipService.ShowOnDisabled="True"><DataGrid.Columns><DataGridTextColumn Header="Row" Binding="{Binding Row}" Width="55"/><DataGridTextColumn Header="Field" Binding="{Binding Area}" Width="85"/><DataGridTextColumn Header="Issue" Binding="{Binding Description}" Width="*"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Padding" Value="4"/><Setter Property="ToolTip" Value="{Binding Description}"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn></DataGrid.Columns><DataGrid.RowStyle><Style TargetType="DataGridRow"><Setter Property="Height" Value="Auto"/><Setter Property="MinHeight" Value="36"/></Style></DataGrid.RowStyle></DataGrid></Grid>
      <TabControl Grid.Column="2"><TabItem Header="Message details" ToolTip="Open Message details." ToolTipService.ShowOnDisabled="True"><TextBox Text="{Binding PreviewText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" Margin="8" ToolTip="Merged addresses, subject, body text and attachment details." ToolTipService.ShowOnDisabled="True"/></TabItem><TabItem Header="Email preview" ToolTip="Open Email preview." ToolTipService.ShowOnDisabled="True"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Preview includes fonts, sizes, emphasis, colours, alignment and lists. Test exported .eml files in your email client for final rendering." Style="{StaticResource MutedText}" Margin="12"/><RichTextBox x:Name="HtmlPreview" Grid.Row="1" IsReadOnly="True" IsDocumentEnabled="False" VerticalScrollBarVisibility="Auto" BorderThickness="0" Padding="16" ToolTip="Formatted preview for the selected row. Review an Outlook draft for final rendering." ToolTipService.ShowOnDisabled="True"/></Grid></TabItem></TabControl>
     </Grid>
    </Grid>
   </TabItem>
   <TabItem Header="4  Outlook connection" ToolTip="Open 4  Outlook connection." ToolTipService.ShowOnDisabled="True">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24" MaxWidth="820" HorizontalAlignment="Left">
     <TextBlock Text="Choose where your drafts will appear" Style="{StaticResource Heading}"/>
     <TextBlock Text="Connect to a mailbox, then create drafts from the Results tab. Each message will be ready to review and send in Outlook." Style="{StaticResource MutedText}"/>
     <StackPanel IsEnabled="{Binding IsEditable}">
      <TextBlock Text="Connection" FontWeight="SemiBold"/>
      <ComboBox ItemsSource="{Binding ConnectionOptions}" SelectedIndex="{Binding SelectedConnection}" MinWidth="450" AutomationProperties.Name="Outlook connection type" ToolTip="Classic Outlook uses the local profile; Microsoft mailbox supports new Outlook with Microsoft 365 or Outlook.com." ToolTipService.ShowOnDisabled="True"/>
      <StackPanel Visibility="{Binding IsClassicConnection, Converter={StaticResource BoolVisibility}}">
       <TextBlock Text="Use the accounts already configured in classic Outlook on this computer. The new Outlook app requires the Microsoft mailbox option." Style="{StaticResource MutedText}"/>
       <Button Content="Connect to classic Outlook" Command="{Binding ConnectClassicCommand}" Style="{StaticResource Primary}" HorizontalAlignment="Left" ToolTip="Read accounts from the current classic Outlook profile." ToolTipService.ShowOnDisabled="True"/>
       <TextBlock Text="Account" FontWeight="SemiBold" Margin="0,12,0,0"/>
       <ComboBox ItemsSource="{Binding ClassicAccounts}" SelectedItem="{Binding SelectedClassicAccount}" DisplayMemberPath="DisplayName" AutomationProperties.Name="Classic Outlook draft account" ToolTip="Choose the mailbox used for drafts and sending." ToolTipService.ShowOnDisabled="True"/>
      </StackPanel>
      <StackPanel Visibility="{Binding IsMicrosoftConnection, Converter={StaticResource BoolVisibility}}">
       <TextBlock Text="For Microsoft 365 or Outlook.com mailboxes. Sign in with Microsoft; drafts will be visible in new Outlook, classic Outlook and Outlook on the web." Style="{StaticResource MutedText}"/>
       <TextBlock Text="Application (client) ID" FontWeight="SemiBold"/>
       <TextBox Text="{Binding MicrosoftClientId, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Microsoft application client ID" ToolTip="Application client ID from your Microsoft app registration; no secret is needed." ToolTipService.ShowOnDisabled="True"/>
       <TextBlock Text="Tenant"/><TextBox Text="{Binding MicrosoftTenant, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Microsoft tenant" ToolTip="Use common, or the tenant supplied by your administrator." ToolTipService.ShowOnDisabled="True"/>
       <TextBlock Text="Use common for a registration supporting work and personal Microsoft accounts, or the tenant ID supplied by your administrator. One-time app registration instructions are in README.md. No client secret is needed." Style="{StaticResource MutedText}"/>
       <CheckBox Content="Enable direct sending (requests Microsoft Mail.Send permission)" IsChecked="{Binding EnableMicrosoftSending}" Margin="0,8,0,12" ToolTip="Request Microsoft Mail.Send permission; reconnect after changing this option." ToolTipService.ShowOnDisabled="True"/>
       <Button Content="Sign in with Microsoft" Command="{Binding ConnectMicrosoftCommand}" Style="{StaticResource Primary}" HorizontalAlignment="Left" ToolTip="Sign in to the Microsoft mailbox using the client ID and tenant." ToolTipService.ShowOnDisabled="True"/>
      </StackPanel>
      <TextBlock Text="{Binding ConnectionSummary}" FontWeight="SemiBold" Margin="0,20,0,12"/>
      <Button Content="Disconnect" Command="{Binding DisconnectCommand}" HorizontalAlignment="Left" ToolTip="Disconnect the active mailbox." ToolTipService.ShowOnDisabled="True"/>
     </StackPanel>
     <Button Content="Cancel connection" Command="{Binding CancelCommand}" HorizontalAlignment="Left" ToolTip="Request cancellation; messages already submitted cannot be recalled." ToolTipService.ShowOnDisabled="True"/>
    </StackPanel></ScrollViewer>
   </TabItem>
   <TabItem Header="5  Results" ToolTip="Open 5  Results." ToolTipService.ShowOnDisabled="True">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24"><Grid MinHeight="640" Height="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <StackPanel><TextBlock Text="Choose how to prepare or send your messages" Style="{StaticResource Heading}"/><TextBlock Text="Export local files, create drafts for review in Outlook, or send directly after confirmation. Submission is recorded locally; recipient delivery is not verified." Style="{StaticResource MutedText}"/><TextBlock Text="{Binding ConnectionSummary}" FontWeight="SemiBold" Margin="0,0,0,12"/><TextBlock Text="{Binding InclusionSummary}" Foreground="{StaticResource Accent}" FontWeight="SemiBold" Margin="0,0,0,16"/>
      <TextBlock Text="Send a test first" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Uses one source row, sent only to your test address with CC and BCC cleared. Includes that row’s attachments and pictures." Style="{StaticResource MutedText}"/>
      <WrapPanel IsEnabled="{Binding IsEditable}"><StackPanel Margin="0,0,12,0"><TextBlock Text="Source row"/><ComboBox ItemsSource="{Binding Recipients}" SelectedItem="{Binding SelectedRecipient}" DisplayMemberPath="Row" Width="100" AutomationProperties.Name="Test email source row" ToolTip="Choose the row supplying personalised body text and attachments for this one test." ToolTipService.ShowOnDisabled="True"/></StackPanel><StackPanel Margin="0,0,12,0"><TextBlock Text="Your test email address"/><TextBox Text="{Binding TestAddress, UpdateSourceTrigger=PropertyChanged}" Width="280" AutomationProperties.Name="Test email destination" ToolTip="Enter one email address you control. The test goes only here; source To, CC and BCC are replaced." ToolTipService.ShowOnDisabled="True"/></StackPanel><Button Content="Send test email…" Command="{Binding SendTestCommand}" VerticalAlignment="Bottom" Margin="0,0,0,12" ToolTip="Validate this row, then confirm sending one real test email. The subject starts with [TEST]; batch send records remain separate." ToolTipService.ShowOnDisabled="True"/></WrapPanel>
     </StackPanel>
     <WrapPanel Grid.Row="1"><Button Content="Create Outlook drafts…" Command="{Binding CreateDraftsCommand}" Style="{StaticResource Primary}" ToolTip="Create messages in Outlook Drafts after confirmation, without sending." ToolTipService.ShowOnDisabled="True"/><Button Content="Export dry run…" Command="{Binding RunCommand}" ToolTip="Export merged messages and files locally without sending." ToolTipService.ShowOnDisabled="True"/><Button Content="Send emails…" Command="{Binding SendCommand}" ToolTip="Send the validated batch through the connected account after final confirmation." ToolTipService.ShowOnDisabled="True"/><TextBlock Text="Seconds between sends" VerticalAlignment="Center" Margin="8,0,4,8"/><TextBox Text="{Binding SendIntervalSeconds}" Width="45" IsEnabled="{Binding IsEditable}" AutomationProperties.Name="Seconds between sends" ToolTip="Delay between submissions, from 1 to 60 seconds; mailbox limits still apply." ToolTipService.ShowOnDisabled="True"/><Button Content="Cancel operation" Command="{Binding CancelCommand}" ToolTip="Request cancellation; messages already submitted cannot be recalled." ToolTipService.ShowOnDisabled="True"/><Button Content="Clear history…" Command="{Binding ClearHistoryCommand}" ToolTip="Remove all saved run history after confirmation. Keep exports, Outlook messages and duplicate-send protection." ToolTipService.ShowOnDisabled="True"/><Button Content="Refresh history" Command="{Binding HistoryCommand}" ToolTip="Reload locally saved run history." ToolTipService.ShowOnDisabled="True"/><TextBlock Text="{Binding Progress}" VerticalAlignment="Center" Margin="12,0,0,8"/></WrapPanel>
     <TextBox Grid.Row="2" Text="{Binding OutputPath, Mode=OneWay}" IsReadOnly="True" ToolTip="Copy this path to File Explorer to inspect local results or dry-run files." AutomationProperties.Name="Local results folder" ToolTipService.ShowOnDisabled="True"/>
     <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <ListBox ItemsSource="{Binding History}" SelectionChanged="HistorySelected" IsEnabled="{Binding IsEditable}" ToolTip="Choose a saved run to inspect its per-recipient results; timestamps are UTC." ToolTipService.ShowOnDisabled="True"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="8"><TextBlock Text="{Binding Started, StringFormat={}{0:dd MMM yyyy HH:mm} UTC}" FontWeight="SemiBold"/><TextBlock Text="{Binding Mode}" Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding Id}" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Results.Count, StringFormat={}{0} recipients}" Margin="0,4,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
      <DataGrid Grid.Column="2" ItemsSource="{Binding Results}" IsReadOnly="True" ToolTip="Per-recipient outcome and saved file or error detail." ToolTipService.ShowOnDisabled="True"><DataGrid.Columns><DataGridTextColumn Header="Row" Binding="{Binding Row}" Width="55"/><DataGridTextColumn Header="Recipient" Binding="{Binding Recipient}" Width="170"/><DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120"/><DataGridTextColumn Header="Detail / location" Binding="{Binding Detail}" Width="*"/></DataGrid.Columns></DataGrid>
     </Grid>
    </Grid></ScrollViewer>
   </TabItem>
   <TabItem Header="Help" ToolTip="Search instructions, troubleshooting and shortcuts." ToolTipService.ShowOnDisabled="True"><controls:HelpView/></TabItem>
  </TabControl>
  <Border Grid.Row="3" Background="#E5ECEE" Padding="24,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Status}" Foreground="#284747" Margin="0,0,20,0"/><TextBlock Grid.Column="1" Text="{Binding AutosaveStatus}" MaxWidth="280" Foreground="#284747" ToolTip="{Binding AutosaveStatus}"/></Grid></Border>
 </Grid>
</Window>
